{
    "manifest_version": 3,
    "name": "SiteSweep",
    "version": "0.1.0",
    "description": "Clear the current website's cache and stored data.",
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Clean this website"
    },
    "icons": {
        "16": "icons/16x16-broom.svg",
        "32": "icons/32x32-broom.svg",
        "48": "icons/48x48-broom.svg",
        "128": "icons/128x128-broom.svg"
    },
    "permissions": [
        "browsingData",
        "tabs",
        "activeTab",
        "scripting"
    ]
}