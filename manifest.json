{
  "manifest_version": 3,
  "name": "SiteSweep",
  "version": "1.0.0",
  "description": "Clear the current website's cache and stored data.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Clean this website",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/Confetti.gif"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "permissions": [
    "browsingData",
    "tabs",
    "activeTab",
    "scripting"
  ]
}
